{
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s %(levelname)s [%(request_id)s] %(name)s.%(funcName)s:%(lineno)d: %(message)s",
    "main_file": "gateway.log",
    "date_format": "%Y%m%d",
    "retention_days": 14,
    "area_files": {
      "arr": "arr.log",
      "compat": "compat.log",
      "sources": "sources.log",
      "datafiles": "datafiles.log"
    },
    "trace_level": "DEBUG",
    "quiet_loggers": [
      "httpx",
      "httpcore"
    ],
    "quiet_paths": [
      "/v1/status",
      "/v1/activity",
      "/v1/health"
    ],
    "slow_request_ms": 5000
  },
  "storage": {
    "data_dir": "data",
    "data_dir_env": "DATA_DIR",
    "output_dir": "cache",
    "output_dir_env": "OUTPUT_DIR",
    "data_files": {
      "database": "gateway.sqlite3",
      "titles": "titles.json",
      "access_token": "access_token"
    },
    "output_paths": {
      "logs": "logs"
    },
    "secret_files": [
      "access_token"
    ],
    "ignored_files": [
      ".write-test"
    ],
    "legacy_data_dirs": [
      "/data"
    ]
  },
  "export": {
    "format": "phonarr-data",
    "version": 1,
    "manifest": "manifest.json",
    "folder": "data",
    "skip_suffixes": [
      "-wal",
      "-shm",
      "-journal"
    ],
    "sqlite_header": "SQLite format 3",
    "staging_prefix": ".import-staging-",
    "chunk_bytes": 1048576,
    "scrub": {
      "database": [
        "DELETE FROM service_config"
      ]
    }
  },
  "gateway": {
    "batch_max": 100,
    "season_modes": [
      "all",
      "first",
      "latest",
      "future"
    ],
    "source_order": [
      "library",
      "list",
      "import_list",
      "recommended",
      "search"
    ],
    "ttl": {
      "library": 600,
      "options": 300,
      "metadata": 604800,
      "pool": 600,
      "search": 300
    },
    "retry_cooldown": 30,
    "compat_every": 86400,
    "poll": {
      "watching": 5,
      "foreground": 20,
      "idle_active": 60,
      "foreground_quiet": 60,
      "client_gone_after": 120,
      "watching_window": 15,
      "idle_health_check": 300
    },
    "down_reminder_every": 3600,
    "poller_error_backoff": 10
  },
  "arr": {
    "timeout": 15.0,
    "connect_timeout": 5.0,
    "timings_kept": 200,
    "names": {
      "radarr": "Radarr",
      "sonarr": "Sonarr"
    },
    "slow_ms": 3000,
    "default_ports": {
      "radarr": 7878,
      "sonarr": 8989
    }
  },
  "http": {
    "gzip_min_bytes": 1024
  },
  "env": {
    "logging.level": "LOG_LEVEL",
    "gateway.batch_max": "BATCH_MAX",
    "arr.timeout": "ARR_TIMEOUT",
    "gateway.poll.idle_health_check": "IDLE_HEALTH_CHECK"
  }
}
