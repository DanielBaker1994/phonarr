{
  "logging": {
    "subsystem": "Phonarr",
    "dir_name": "Logs",
    "main_file": "app.log",
    "date_format": "yyyyMMdd",
    "retention_days": 14,
    "max_bytes": 1048576,
    "min_secret_length": 6,
    "area_files": {"api": "api.log"}
  },
  "calendar": {
    "past_days": 7,
    "future_days": 30,
    "more_days": 14
  },
  "api": {
    "log_body_chars": 300
  },
  "logs": {
    "lines": 1000,
    "clock_warn_seconds": 120
  }
}
