# Build context is the repo root (see backend/Dockerfile). Only backend/app, backend/requirements.txt and web/ are used.
*
!backend/requirements.txt
!backend/app/
!web/
**/__pycache__
**/*.pyc
web/tests/
# Never in the image, even if the allow-list above changes: data, rebuildable output, secrets.
backend/data/
backend/devdata/
backend/cache/
**/.env
