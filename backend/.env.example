# Used by backend/docker-compose.yml (./build-web.sh). Never commit the real .env.
ARR_GATEWAY_TOKEN=change-me-to-a-long-random-string
# The external Docker network your radarr and sonarr containers are on (docker network ls).
ARR_NETWORK=arr
# Same values as your Arr containers: the owner of backend/data on the host (id -u / id -g) and your timezone.
PUID=1000
PGID=1000
TZ=Etc/UTC
